<!DOCTYPE html>

<html lang="it">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Architettura Fascista — Via Roma, Torino</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;0,700;1,300;1,400&family=Cinzel:wght@400;600;700&family=Montserrat:wght@300;400;500;600&display=swap');
:root{--oro:#C8A96E;--oro-light:#E2C98E;--nero:#0D0D18;--marmo:#1A1A2E;--avorio:#F5F0E8;--grigio:#8A8A9A;--rosso:#8B1A1A;--travert:#D8D0C0}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{background:var(--nero);color:var(--avorio);font-family:'Cormorant Garamond',serif;overflow-x:hidden;cursor:none}
.cursor{position:fixed;width:12px;height:12px;background:var(--oro);border-radius:50%;pointer-events:none;z-index:9999;transform:translate(-50%,-50%);transition:width .3s,height .3s;mix-blend-mode:difference}
.cursor-ring{position:fixed;width:36px;height:36px;border:1px solid var(--oro);border-radius:50%;pointer-events:none;z-index:9998;transform:translate(-50%,-50%);transition:width .3s,height .3s;opacity:.5}
.progress-bar{position:fixed;top:0;left:0;height:3px;background:linear-gradient(to right,var(--rosso),var(--oro));z-index:200;width:0%;transition:width .1s linear}
nav{position:fixed;top:0;left:0;right:0;z-index:100;padding:1.4rem 4rem;display:flex;justify-content:space-between;align-items:center;background:linear-gradient(to bottom,rgba(13,13,24,.97) 0%,transparent 100%);backdrop-filter:blur(4px)}
.nav-logo{font-family:'Cinzel',serif;font-size:.72rem;letter-spacing:.3em;color:var(--oro);text-transform:uppercase;cursor:pointer}
.nav-links{display:flex;gap:2.5rem;list-style:none}
.nav-links a{font-family:'Montserrat',sans-serif;font-size:.62rem;letter-spacing:.22em;color:var(--grigio);text-decoration:none;text-transform:uppercase;transition:color .3s;position:relative}
.nav-links a::after{content:'';position:absolute;bottom:-4px;left:0;width:0;height:1px;background:var(--oro);transition:width .4s ease}
.nav-links a:hover{color:var(--oro)}
.nav-links a:hover::after{width:100%}
.section-dots{position:fixed;right:1.8rem;top:50%;transform:translateY(-50%);display:flex;flex-direction:column;gap:1rem;z-index:100}
.section-dot{width:6px;height:6px;border-radius:50%;background:rgba(200,169,110,.25);cursor:pointer;transition:background .3s,transform .3s}
.section-dot.active{background:var(--oro);transform:scale(1.6)}
.section-dot:hover{background:var(--oro-light)}
section{min-height:100vh;position:relative;display:flex;align-items:center;justify-content:center;overflow:hidden}
#hero{flex-direction:column;background:var(--nero)}
.hero-bg{position:absolute;inset:0;background:radial-gradient(ellipse 80% 60% at 50% 0%,rgba(200,169,110,.07) 0%,transparent 60%),radial-gradient(ellipse 40% 40% at 80% 80%,rgba(139,26,26,.05) 0%,transparent 50%)}
.grid-lines{position:absolute;inset:0;pointer-events:none}
.grid-lines::before{content:'';position:absolute;inset:0;background-image:linear-gradient(rgba(200,169,110,.035) 1px,transparent 1px),linear-gradient(90deg,rgba(200,169,110,.035) 1px,transparent 1px);background-size:80px 80px;animation:gridShift 22s linear infinite}
@keyframes gridShift{0%{transform:translateY(0)}100%{transform:translateY(80px)}}
.hero-content{position:relative;z-index:2;text-align:center;padding:2rem}
.hero-eyebrow{font-family:'Montserrat',sans-serif;font-size:.63rem;letter-spacing:.42em;color:var(--oro);text-transform:uppercase;opacity:0;transform:translateY(20px);animation:fadeUp 1s ease forwards .3s}
.hero-title{font-family:'Cinzel',serif;font-size:clamp(3rem,8vw,7rem);font-weight:700;line-height:1.05;margin:1.4rem 0 .5rem;opacity:0;transform:translateY(30px);animation:fadeUp 1.2s ease forwards .6s}
.hero-title span{display:block;background:linear-gradient(135deg,var(--oro-light) 0%,var(--oro) 50%,#9A7A4E 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.hero-subtitle{font-family:'Cormorant Garamond',serif;font-size:clamp(1.1rem,2.5vw,1.5rem);font-weight:300;font-style:italic;color:var(--travert);margin-bottom:2.5rem;opacity:0;transform:translateY(20px);animation:fadeUp 1s ease forwards .9s}
.hero-line{width:0;height:1px;background:var(--oro);margin:0 auto 2.5rem;animation:lineGrow 1.2s ease forwards 1.2s}
@keyframes lineGrow{to{width:120px}}
.hero-meta{display:flex;gap:4rem;justify-content:center;opacity:0;transform:translateY(20px);animation:fadeUp 1s ease forwards 1.5s}
.hero-meta-item{text-align:center}
.hero-meta-num{font-family:'Cinzel',serif;font-size:2rem;color:var(--oro);display:block}
.hero-meta-label{font-family:'Montserrat',sans-serif;font-size:.58rem;letter-spacing:.2em;color:var(--grigio);text-transform:uppercase}
.scroll-hint{position:absolute;bottom:2.5rem;left:50%;transform:translateX(-50%);display:flex;flex-direction:column;align-items:center;gap:.5rem;opacity:0;animation:fadeIn 1s ease forwards 2.2s}
.scroll-hint span{font-family:'Montserrat',sans-serif;font-size:.54rem;letter-spacing:.3em;color:var(--grigio);text-transform:uppercase}
.scroll-line{width:1px;height:50px;background:linear-gradient(to bottom,var(--oro),transparent);animation:scrollPulse 2s ease-in-out infinite}
@keyframes scrollPulse{0%,100%{opacity:.3}50%{opacity:1}}
.section-inner{max-width:1200px;width:100%;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:6rem;align-items:center;padding:0 2rem}
.section-label{font-family:'Montserrat',sans-serif;font-size:.6rem;letter-spacing:.4em;color:var(--oro);text-transform:uppercase;margin-bottom:1.4rem;display:flex;align-items:center;gap:1rem}
.section-label::before{content:'';display:inline-block;width:28px;height:1px;background:var(--oro)}
.section-title{font-family:'Cinzel',serif;font-size:clamp(2rem,4vw,3rem);font-weight:600;line-height:1.2;margin-bottom:1.8rem;color:var(--avorio)}
.section-body{font-size:1.05rem;font-weight:300;line-height:1.9;color:var(--travert);margin-bottom:1.4rem}
.section-body em{color:var(--oro);font-style:italic}
.cards-grid{display:grid;grid-template-columns:1fr 1fr;gap:1px;background:rgba(200,169,110,.12);border:1px solid rgba(200,169,110,.12)}
.card{background:rgba(13,13,24,.85);padding:1.8rem;position:relative;overflow:hidden;transition:background .4s;cursor:default}
.card::before{content:'';position:absolute;top:0;left:0;width:3px;height:0;background:var(--oro);transition:height .5s ease}
.card:hover{background:rgba(200,169,110,.05)}
.card:hover::before{height:100%}
.card-num{font-family:'Cinzel',serif;font-size:2.2rem;color:rgba(200,169,110,.12);font-weight:700;line-height:1;margin-bottom:.4rem}
.card-title{font-family:'Cinzel',serif;font-size:.88rem;color:var(--oro);margin-bottom:.7rem;letter-spacing:.04em}
.card-text{font-size:.88rem;font-weight:300;line-height:1.7;color:var(--grigio)}
#contesto{background:var(--marmo);padding:6rem 4rem}
#architetti{background:var(--nero);padding:6rem 4rem;align-items:flex-start}
.arch-container{max-width:1200px;width:100%;margin:0 auto}
.arch-header{text-align:center;margin-bottom:4rem}
.arch-profiles{display:grid;grid-template-columns:1fr 1fr;gap:2.5rem}
.profile{position:relative;padding:2.8rem;border:1px solid rgba(200,169,110,.1);background:linear-gradient(135deg,rgba(26,26,46,.8) 0%,rgba(13,13,24,.9) 100%);transition:border-color .4s,transform .4s;overflow:hidden;cursor:default}
.profile::after{content:'';position:absolute;top:0;right:0;width:0;height:0;border-left:40px solid transparent;border-top:40px solid rgba(200,169,110,.12);transition:border-color .4s}
.profile:hover{border-color:rgba(200,169,110,.4);transform:translateY(-4px)}
.profile:hover::after{border-top-color:rgba(200,169,110,.35)}
.profile-role{font-family:'Montserrat',sans-serif;font-size:.54rem;letter-spacing:.35em;color:var(--oro);text-transform:uppercase;margin-bottom:.7rem}
.profile-name{font-family:'Cinzel',serif;font-size:1.55rem;font-weight:600;color:var(--avorio);margin-bottom:.3rem;line-height:1.2}
.profile-dates{font-family:'Montserrat',sans-serif;font-size:.68rem;color:var(--grigio);letter-spacing:.1em;margin-bottom:1.8rem;padding-bottom:1.4rem;border-bottom:1px solid rgba(200,169,110,.13)}
.profile-text{font-size:.98rem;font-weight:300;line-height:1.8;color:var(--travert)}
.profile-text em{color:var(--oro);font-style:italic}
#timeline{background:var(--marmo);padding:7rem 4rem;align-items:flex-start}
.timeline-container{max-width:1000px;width:100%;margin:0 auto}
.timeline-header{text-align:center;margin-bottom:5rem}
.timeline-track{position:relative;padding-left:3.5rem}
.timeline-track::before{content:'';position:absolute;left:0;top:0;bottom:0;width:1px;background:linear-gradient(to bottom,transparent 0%,var(--oro) 8%,var(--oro) 92%,transparent 100%)}
.timeline-item{position:relative;padding:0 0 4rem 3rem;opacity:0;transform:translateX(-30px);transition:opacity .7s ease,transform .7s ease}
.timeline-item.visible{opacity:1;transform:translateX(0)}
.timeline-item::before{content:'';position:absolute;left:-4px;top:.4rem;width:9px;height:9px;border-radius:50%;background:var(--oro);box-shadow:0 0 0 4px var(--marmo),0 0 0 5px var(--oro)}
.timeline-year{font-family:'Cinzel',serif;font-size:1.4rem;color:var(--oro);font-weight:700;margin-bottom:.3rem}
.timeline-label{font-family:'Montserrat',sans-serif;font-size:.63rem;letter-spacing:.2em;color:var(--grigio);text-transform:uppercase;margin-bottom:.9rem}
.timeline-text{font-size:.98rem;font-weight:300;line-height:1.8;color:var(--travert);max-width:600px}
.timeline-photo{margin-top:1.2rem;border:1px solid rgba(200,169,110,.2);overflow:hidden;max-width:520px;position:relative;cursor:pointer}
.timeline-photo img{width:100%;display:block;filter:sepia(.4) contrast(1.05);transition:filter .5s,transform .6s}
.timeline-photo:hover img{filter:sepia(.1) contrast(1.1);transform:scale(1.03)}
.timeline-photo-caption{position:absolute;bottom:0;left:0;right:0;padding:.7rem 1rem;background:linear-gradient(to top,rgba(13,13,24,.9),transparent);font-family:'Montserrat',sans-serif;font-size:.55rem;letter-spacing:.2em;color:var(--oro);text-transform:uppercase}
#elementi{background:var(--nero);padding:6rem 4rem;align-items:flex-start}
.elements-container{max-width:1200px;width:100%;margin:0 auto}
.elements-header{text-align:center;margin-bottom:4.5rem}
.elements-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:2px;background:rgba(200,169,110,.07)}
.element-card{background:var(--nero);padding:2.3rem 1.8rem;position:relative;overflow:hidden;cursor:default;opacity:0;transform:translateY(20px);transition:opacity .6s ease,transform .6s ease,background .4s}
.element-card.visible{opacity:1;transform:translateY(0)}
.element-card:hover{background:rgba(200,169,110,.04)}
.element-card::before{content:'';position:absolute;bottom:0;left:0;right:0;height:0;background:linear-gradient(to top,rgba(200,169,110,.07),transparent);transition:height .5s ease}
.element-card:hover::before{height:100%}
.element-icon{width:38px;height:38px;border:1px solid rgba(200,169,110,.3);display:flex;align-items:center;justify-content:center;margin-bottom:1.4rem;font-family:'Cinzel',serif;font-size:.8rem;color:var(--oro);transition:border-color .3s,background .3s}
.element-card:hover .element-icon{border-color:var(--oro);background:rgba(200,169,110,.08)}
.element-title{font-family:'Cinzel',serif;font-size:.88rem;color:var(--oro);margin-bottom:.9rem;letter-spacing:.04em}
.element-text{font-size:.88rem;font-weight:300;line-height:1.8;color:var(--grigio)}
#prima-dopo{background:var(--nero);padding:7rem 4rem;align-items:flex-start}
.pd-container{max-width:1300px;width:100%;margin:0 auto}
.pd-header{text-align:center;margin-bottom:5rem}
.pd-compare{display:grid;grid-template-columns:1fr 1fr;gap:3rem;align-items:start}
.pd-side-label{font-family:'Montserrat',sans-serif;font-size:.6rem;letter-spacing:.35em;text-transform:uppercase;margin-bottom:1.2rem;display:flex;align-items:center;gap:.8rem}
.pd-side-label::before{content:'';display:inline-block;width:20px;height:1px}
.pd-side-label.before-label{color:#A09060}
.pd-side-label.before-label::before{background:#A09060}
.pd-side-label.after-label{color:var(--oro)}
.pd-side-label.after-label::before{background:var(--oro)}
.pd-img{width:100%;display:block;border:1px solid rgba(200,169,110,.15);transition:filter .4s,transform .4s;cursor:pointer}
.pd-img:hover{filter:brightness(1.08);transform:scale(1.01)}
.pd-caption{margin-top:1rem;padding:1.2rem 1.4rem;background:rgba(26,26,46,.7);border-left:3px solid var(--oro)}
.pd-caption-year{font-family:'Cinzel',serif;font-size:1.05rem;color:var(--oro);margin-bottom:.35rem}
.pd-caption-text{font-size:.9rem;font-weight:300;line-height:1.7;color:var(--travert)}
.pd-grid-2{display:grid;grid-template-columns:1fr 1fr;gap:4px;margin-top:1rem}
.pd-grid-2 img{width:100%;display:block;border:1px solid rgba(200,169,110,.1);transition:filter .4s,transform .4s;cursor:pointer}
.pd-grid-2 img:hover{filter:brightness(1.1);transform:scale(1.02)}
.pd-sub-label{font-family:'Montserrat',sans-serif;font-size:.52rem;letter-spacing:.18em;text-transform:uppercase;padding:.45rem .3rem}
#controversie{background:var(--marmo);padding:6rem 4rem}
.contr-container{max-width:1200px;width:100%;margin:0 auto}
.contr-header{text-align:center;margin-bottom:4.5rem}
.contr-split{display:grid;grid-template-columns:1fr 1px 1fr;gap:4rem;align-items:start}
.contr-divider{background:rgba(200,169,110,.18);align-self:stretch}
.contr-side-label{font-family:'Montserrat',sans-serif;font-size:.58rem;letter-spacing:.3em;text-transform:uppercase;margin-bottom:2rem;padding-bottom:.9rem;border-bottom:1px solid}
.contr-side-label.neg{color:#D07070;border-color:rgba(208,112,112,.25)}
.contr-side-label.pos{color:#70D0A0;border-color:rgba(112,208,160,.25)}
.contr-item{display:flex;gap:1rem;margin-bottom:1.4rem;opacity:0;transform:translateY(15px);transition:opacity .5s ease,transform .5s ease}
.contr-item.visible{opacity:1;transform:translateY(0)}
.contr-dot{width:6px;height:6px;border-radius:50%;flex-shrink:0;margin-top:.55rem}
.contr-dot.neg{background:#D07070}
.contr-dot.pos{background:#70D0A0}
.contr-text{font-size:.94rem;font-weight:300;line-height:1.7;color:var(--travert)}
#citazione{background:var(--nero);position:relative}
.quote-bg{position:absolute;inset:0;background:radial-gradient(ellipse 60% 80% at 50% 50%,rgba(200,169,110,.05) 0%,transparent 70%)}
.quote-content{position:relative;z-index:2;text-align:center;max-width:800px;padding:4rem}
.quote-mark{font-family:'Cinzel',serif;font-size:8rem;line-height:.5;color:rgba(200,169,110,.1);display:block;margin-bottom:1.8rem}
.quote-text{font-family:'Cormorant Garamond',serif;font-size:clamp(1.4rem,3vw,2.1rem);font-style:italic;font-weight:300;line-height:1.65;color:var(--avorio);margin-bottom:2.5rem;opacity:0;transform:translateY(20px);transition:opacity 1s ease,transform 1s ease}
.quote-text.visible{opacity:1;transform:translateY(0)}
.quote-em{color:var(--oro);font-style:normal;font-weight:400}
.quote-author{font-family:'Montserrat',sans-serif;font-size:.63rem;letter-spacing:.3em;color:var(--oro);text-transform:uppercase;opacity:0;transform:translateY(10px);transition:opacity 1s ease .3s,transform 1s ease .3s}
.quote-author.visible{opacity:1;transform:translateY(0)}
#conclusione{background:linear-gradient(to bottom,var(--nero) 0%,#080810 100%)}
.concl-content{text-align:center;max-width:780px;padding:4rem}
.concl-title{font-family:'Cinzel',serif;font-size:clamp(2rem,5vw,3.8rem);font-weight:700;margin-bottom:2.5rem;color:var(--avorio);line-height:1.1}
.concl-title span{display:block;background:linear-gradient(135deg,var(--oro-light),var(--oro));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.concl-text{font-size:1.05rem;font-weight:300;line-height:1.9;color:var(--travert);margin-bottom:1.4rem}
.concl-mies{font-family:'Cinzel',serif;color:var(--oro);font-size:.84rem;letter-spacing:.1em;margin-top:2.5rem}
.concl-mies-attr{font-family:'Montserrat',sans-serif;font-size:.58rem;letter-spacing:.2em;color:var(--grigio);margin-top:.4rem}
.concl-cta{display:inline-flex;align-items:center;gap:.7rem;margin-top:3rem;font-family:'Montserrat',sans-serif;font-size:.63rem;letter-spacing:.28em;color:var(--oro);text-transform:uppercase;text-decoration:none;border:1px solid rgba(200,169,110,.3);padding:.9rem 2.4rem;transition:border-color .3s,background .3s,color .3s;cursor:pointer}
.concl-cta:hover{background:var(--oro);color:var(--nero);border-color:var(--oro)}
@keyframes fadeUp{from{opacity:0;transform:translateY(30px)}to{opacity:1;transform:translateY(0)}}
@keyframes fadeIn{from{opacity:0}to{opacity:1}}
.reveal{opacity:0;transform:translateY(30px);transition:opacity .8s ease,transform .8s ease}
.reveal.visible{opacity:1;transform:translateY(0)}
.reveal-left{opacity:0;transform:translateX(-40px);transition:opacity .8s ease,transform .8s ease}
.reveal-left.visible{opacity:1;transform:translateX(0)}
.reveal-right{opacity:0;transform:translateX(40px);transition:opacity .8s ease,transform .8s ease}
.reveal-right.visible{opacity:1;transform:translateX(0)}
.delay-1{transition-delay:.12s}.delay-2{transition-delay:.24s}.delay-3{transition-delay:.36s}.delay-4{transition-delay:.48s}.delay-5{transition-delay:.6s}
.particle{position:fixed;pointer-events:none;width:2px;height:2px;background:var(--oro);border-radius:50%;opacity:0;z-index:50;animation:floatUp 4s ease-in-out infinite}
@keyframes floatUp{0%{opacity:0;transform:translateY(0) scale(0)}20%{opacity:.6;transform:translateY(-20px) scale(1)}80%{opacity:.2;transform:translateY(-80px) scale(.5)}100%{opacity:0;transform:translateY(-120px) scale(0)}}
@media(max-width:900px){nav{padding:1rem 1.5rem}.nav-links{display:none}.section-inner,.arch-profiles,.contr-split,.pd-compare{grid-template-columns:1fr;gap:2.5rem}.elements-grid{grid-template-columns:1fr 1fr}.contr-divider{display:none}.section-dots{display:none}#contesto,#architetti,#timeline,#elementi,#prima-dopo,#controversie,#citazione,#conclusione{padding:5rem 1.5rem}.hero-meta{gap:2rem}}
</style>
</head>
<body>
<div class="cursor" id="cursor"></div>
<div class="cursor-ring" id="cursorRing"></div>
<div class="progress-bar" id="progressBar"></div>
<div class="section-dots" id="sectionDots">
  <div class="section-dot active" data-target="hero"></div>
  <div class="section-dot" data-target="contesto"></div>
  <div class="section-dot" data-target="architetti"></div>
    <div class="section-dot" data-target="elementi"></div>
  <div class="section-dot" data-target="prima-dopo"></div>
  <div class="section-dot" data-target="controversie"></div>
  <div class="section-dot" data-target="citazione"></div>
  <div class="section-dot" data-target="conclusione"></div>
</div>
<nav>
  <div class="nav-logo" onclick="scrollTo('hero')">Via Roma &middot; Torino</div>
  <ul class="nav-links">
    <li><a href="#" onclick="scrollTo('contesto');return false">Contesto</a></li>
    <li><a href="#" onclick="scrollTo('architetti');return false">Architetti</a></li>
    <li><a href="#" onclick="scrollTo('elementi');return false">Elementi</a></li>
    <li><a href="#" onclick="scrollTo('prima-dopo');return false">Prima &amp; Dopo</a></li>
    <li><a href="#" onclick="scrollTo('controversie');return false">Controversie</a></li>
  </ul>
</nav>

<!-- HERO -->

<section id="hero">
  <div class="hero-bg"></div><div class="grid-lines"></div>
  <div class="hero-content">
    <p class="hero-eyebrow">Storia dell&rsquo;Architettura Italiana &middot; 1931&ndash;1937</p>
    <h1 class="hero-title">Architettura<br><span>Fascista</span></h1>
    <p class="hero-subtitle">Via Roma, Torino &mdash; Il potere tradotto in pietra</p>
    <div class="hero-line"></div>
    <div class="hero-meta">
      <div class="hero-meta-item"><span class="hero-meta-num" data-count="460">0</span><span class="hero-meta-label">Metri di lunghezza</span></div>
      <div class="hero-meta-item"><span class="hero-meta-num">1937</span><span class="hero-meta-label">Anno inaugurazione</span></div>
      <div class="hero-meta-item"><span class="hero-meta-num" data-count="200">0</span><span class="hero-meta-label">Edifici demoliti</span></div>
    </div>
  </div>
  <div class="scroll-hint"><span>Scorri</span><div class="scroll-line"></div></div>
</section>

<!-- CONTESTO -->

<section id="contesto">
  <div class="section-inner">
    <div class="reveal-left">
      <p class="section-label">Contesto storico</p>
      <h2 class="section-title">Il Regime e<br>l&rsquo;Urbanistica</h2>
      <p class="section-body">Dal 1925, il fascismo esercita un potere <em>dittatoriale assoluto</em>. L&rsquo;architettura diventa strumento di propaganda: le citt&agrave; vengono ridisegnate per trasmettere ordine, potenza e romanit&agrave; imperiale.</p>
      <p class="section-body">Torino non sfugge a questa logica. Il progetto di Via Roma nasce dalla volont&agrave; di cancellare il tessuto medievale e sostituirlo con un <em>manifesto in pietra</em> della nuova Italia.</p>
    </div>
    <div class="reveal-right">
      <div class="cards-grid">
        <div class="card"><div class="card-num">01</div><div class="card-title">Gli Anni &rsquo;30</div><p class="card-text">L&rsquo;architettura come propaganda. Le citt&agrave; ridisegnate per trasmettere potere e modernit&agrave; imperiale.</p></div>
        <div class="card"><div class="card-num">02</div><div class="card-title">Lo Sventramento</div><p class="card-text">Demolizione di ~200 edifici medievali e barocchi. Torino perde il suo centro storico.</p></div>
        <div class="card"><div class="card-num">03</div><div class="card-title">Stile Razionalista</div><p class="card-text">Fusione tra razionalismo moderno e monumentalismo classico. Geometrie severe del potere.</p></div>
        <div class="card"><div class="card-num">04</div><div class="card-title">Il Mandato</div><p class="card-text">Un concorso nazionale vinto nel 1930. Il piano Piacentini&ndash;Bonad&egrave; Bottino trasforma la citt&agrave;.</p></div>
      </div>
    </div>
  </div>
</section>

<!-- ARCHITETTI -->

<section id="architetti">
  <div class="arch-container">
    <div class="arch-header">
      <p class="section-label reveal" style="justify-content:center">I Protagonisti</p>
      <h2 class="section-title reveal delay-1">Gli Architetti del Progetto</h2>
    </div>
    <div class="arch-profiles">
      <div class="profile reveal delay-2">
        <p class="profile-role">Progettista generale</p>
        <h3 class="profile-name">Marcello Piacentini</h3>
        <p class="profile-dates">Roma, 1881 &mdash; 1960</p>
        <p class="profile-text">Il pi&ugrave; influente urbanista del regime. Fautore di un <em>&laquo;razionalismo classico&raquo;</em> che coniugava modernit&agrave; e romanit&agrave; imperiale. Autore dell&rsquo;EUR, della Sapienza e di numerose sistemazioni urbane in tutta Italia.</p>
      </div>
      <div class="profile reveal delay-3">
        <p class="profile-role">Direttore dei lavori</p>
        <h3 class="profile-name">Vittorio Bonad&egrave; Bottino</h3>
        <p class="profile-dates">Torino, 1889 &mdash; 1985</p>
        <p class="profile-text">Torinese, profondo conoscitore del contesto urbano locale. Responsabile del coordinamento esecutivo del cantiere. Traduttore della grande visione nella <em>realt&agrave; costruttiva</em> di una citt&agrave; reale.</p>
      </div>
    </div>
  </div>
</section>

<!-- ELEMENTI -->

<section id="elementi">
  <div class="elements-container">
    <div class="elements-header">
      <p class="section-label reveal" style="justify-content:center">Linguaggio architettonico</p>
      <h2 class="section-title reveal delay-1">Elementi e Stilemi</h2>
    </div>
    <div class="elements-grid">
      <div class="element-card"><div class="element-icon">I</div><h3 class="element-title">Portici su Pilastri</h3><p class="element-text">Colonnati e pilastri massicci scandiscono il ritmo delle facciate, creando ombre profonde e prospettive continue lungo tutto l&rsquo;asse viario.</p></div>
      <div class="element-card"><div class="element-icon">II</div><h3 class="element-title">Geometrie Severe</h3><p class="element-text">Finestre regolari, cornici orizzontali, assenza di ornamento superfluo: il rigore geometrico &egrave; la firma del razionalismo fascista.</p></div>
      <div class="element-card"><div class="element-icon">III</div><h3 class="element-title">Rivestimenti Lapidei</h3><p class="element-text">Travertino romano e granito grigio per i piani bassi. Marmi colorati negli interni delle gallerie. Ogni pietra comunica solidit&agrave; imperiale.</p></div>
      <div class="element-card"><div class="element-icon">IV</div><h3 class="element-title">Gallerie Coperte</h3><p class="element-text">Le due gallerie parallele consentono il passaggio pedonale riparato, ispirate alle grandi gallerie europee ma reinterpretate in chiave monumentale.</p></div>
      <div class="element-card"><div class="element-icon">V</div><h3 class="element-title">Simmetria Assiale</h3><p class="element-text">L&rsquo;asse visivo perfettamente simmetrico richiama l&rsquo;urbanistica romana imperiale. Le facciate si specchiano: citt&agrave; come volont&agrave;, non come organismo.</p></div>
      <div class="element-card"><div class="element-icon">VI</div><h3 class="element-title">Sculture Allegoriche</h3><p class="element-text">Bassorilievi e figure allegoriche celebrano il lavoro, la nazione e la forza. L&rsquo;arte &egrave; integrata come messaggio politico nell&rsquo;architettura.</p></div>
    </div>
  </div>
</section>

<!-- PRIMA E DOPO -->

<section id="prima-dopo">
  <div class="pd-container">
    <div class="pd-header">
      <p class="section-label reveal" style="justify-content:center">Trasformazione urbana</p>
      <h2 class="section-title reveal delay-1">Il Centro di Torino: Prima e Dopo</h2>
      <p class="reveal delay-2" style="font-size:1rem;font-weight:300;color:var(--grigio);max-width:640px;margin:1rem auto 0;line-height:1.8;font-family:'Cormorant Garamond',serif;font-style:italic">Cinque fotografie originali documentano la metamorfosi di Via Roma: dai tram e la vita di quartiere, alle fondamenta scavate, alla parata del 1937, fino alla strada che conosciamo oggi.</p>
    </div>
    <div class="pd-compare">
      <div class="pd-side reveal-left">
        <p class="pd-side-label before-label">Prima &mdash; Ante 1930</p>
        <img class="pd-img" src="data:image/jpeg;base64," alt="Via Roma prima con tram">
        <div class="pd-caption">
          <div class="pd-caption-year">Via Roma originale, ~1920</div>
          <p class="pd-caption-text">Tessuto medievale e barocco irregolare. Vicoli stretti, tram a cavallo, vita popolare di quartiere. Una Torino cancellata per sempre.</p>
        </div>
        <img class="pd-img" src="data:image/jpeg;base64," alt="Cantiere fondamenta 1931" style="margin-top:1rem">
        <div class="pd-caption">
          <div class="pd-caption-year">Le fondamenta, 1931</div>
          <p class="pd-caption-text">Il grande scavo. Le fondamenta dei nuovi edifici razionalisti vengono aperte dove sorgevano i vecchi quartieri popolari.</p>
        </div>
      </div>
      <div class="pd-side reveal-right">
        <p class="pd-side-label after-label">Dopo &mdash; 1937 ad oggi</p>
        <img class="pd-img" src="data:image/jpeg;base64," alt="Parata inaugurazione 1937">
        <div class="pd-caption">
          <div class="pd-caption-year">Inaugurazione, 1937</div>
          <p class="pd-caption-text">La parata militare percorre la nuova Via Roma. L&rsquo;architettura uniforme e simmetrica amplifica la retorica del potere.</p>
        </div>
        <div class="pd-grid-2">
          <div>
            <img src="data:image/jpeg;base64," alt="Via Roma anni 60">
            <div class="pd-sub-label" style="color:var(--grigio)">Anni &rsquo;80</div>
          </div>
          <div>
            <img src="data:image/jpeg;base64," alt="Via Roma oggi" style="height:100%;object-fit:cover">
            <div class="pd-sub-label" style="color:var(--oro)">Oggi</div>
          </div>
        </div>
        <div class="pd-caption">
          <div class="pd-caption-year">Dagli anni &rsquo;80 ad oggi</div>
          <p class="pd-caption-text">Via Roma sopravvive al regime. Dai neon degli anni Ottanta alla silenziosa eleganza contemporanea: l&rsquo;architettura rimane, le ideologie passano.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- CONTROVERSIE -->

<section id="controversie">
  <div class="contr-container">
    <div class="contr-header">
      <p class="section-label reveal" style="justify-content:center">Analisi critica</p>
      <h2 class="section-title reveal delay-1">Luci e Ombre di Via Roma</h2>
    </div>
    <div class="contr-split">
      <div>
        <p class="contr-side-label neg">&#9888; Aspetti Critici</p>
        <div class="contr-item"><div class="contr-dot neg"></div><p class="contr-text">Demolizione irreversibile di ~200 edifici storici medievali e barocchi di indubbio valore culturale</p></div>
        <div class="contr-item"><div class="contr-dot neg"></div><p class="contr-text">Cancellazione di quartieri popolari e del tessuto sociale preesistente senza alcuna consultazione</p></div>
        <div class="contr-item"><div class="contr-dot neg"></div><p class="contr-text">Strumento di propaganda politica di un regime che port&ograve; la nazione alla guerra e al disastro</p></div>
        <div class="contr-item"><div class="contr-dot neg"></div><p class="contr-text">Espulsione forzata di comunit&agrave; residenti per fare spazio alla &laquo;modernit&agrave;&raquo; del regime</p></div>
        <div class="contr-item"><div class="contr-dot neg"></div><p class="contr-text">Dibattito storiografico ancora aperto sulla legittimit&agrave; degli &laquo;sventramenti&raquo; urbani fascisti</p></div>
      </div>
      <div class="contr-divider"></div>
      <div>
        <p class="contr-side-label pos">&#10003; Eredit&agrave; Positiva</p>
        <div class="contr-item"><div class="contr-dot pos"></div><p class="contr-text">Riconosciuta oggi come una delle pi&ugrave; eleganti arterie commerciali d&rsquo;Italia</p></div>
        <div class="contr-item"><div class="contr-dot pos"></div><p class="contr-text">Modello di coerenza stilistica e unit&agrave; urbanistica raramente raggiunto nel Novecento italiano</p></div>
        <div class="contr-item"><div class="contr-dot pos"></div><p class="contr-text">Oggetto di studio nelle facolt&agrave; di architettura di tutto il mondo per la qualit&agrave; del progetto</p></div>
        <div class="contr-item"><div class="contr-dot pos"></div><p class="contr-text">Rilancio economico del centro storico di Torino e impulso allo sviluppo commerciale</p></div>
        <div class="contr-item"><div class="contr-dot pos"></div><p class="contr-text">Patrimonio architettonico tutelato e conservato, integrato nella vita della citt&agrave; contemporanea</p></div>
      </div>
    </div>
  </div>
</section>

<!-- CITAZIONE -->

<section id="citazione">
  <div class="quote-bg"></div>
  <div class="quote-content">
    <span class="quote-mark">&ldquo;</span>
    <p class="quote-text">Non possiamo guardare Via Roma con innocenza. La <span class="quote-em">bellezza non cancella il contesto</span>. Ogni volta che percorriamo quei portici, camminiamo su un palinsesto di storia &mdash; uno strato di marmo fascista sopra una stratificazione di vite e di strade che non ci sono pi&ugrave;.</p>
    <p class="quote-author">&mdash; Discorso accademico &middot; 2025</p>
  </div>
</section>

<!-- CONCLUSIONE -->

<section id="conclusione">
  <div class="concl-content">
    <h2 class="concl-title reveal">Un&rsquo;Eredit&agrave;<br><span>Ambivalente</span></h2>
    <p class="concl-text reveal delay-1">Via Roma ci chiede di tenere insieme due verit&agrave; scomode: che &egrave; bella, e che &egrave; il frutto di una dittatura. Non possiamo sciogliere questa tensione.</p>
    <p class="concl-text reveal delay-2">Possiamo solo scegliere di guardarla in tutta la sua complessit&agrave; &mdash; e portare quella complessit&agrave; nel nostro lavoro, oggi e in futuro.</p>
    <p class="concl-mies reveal delay-3">&laquo;L&rsquo;architettura &egrave; la volont&agrave; di un&rsquo;epoca tradotta in spazio.&raquo;</p>
    <p class="concl-mies-attr reveal delay-4">&mdash; MIES VAN DER ROHE</p>
    <a class="concl-cta reveal delay-5" href="#" onclick="scrollTo('hero');return false">&#8593; Torna all&rsquo;inizio</a>
  </div>
</section>

<script>
var _scrollTo=function(id){var el=document.getElementById(id);if(el)el.scrollIntoView({behavior:'smooth'})};
function scrollTo(id){_scrollTo(id)}
var cursor=document.getElementById('cursor');
var ring=document.getElementById('cursorRing');
var mx=0,my=0,rx=0,ry=0;
document.addEventListener('mousemove',function(e){mx=e.clientX;my=e.clientY;cursor.style.left=mx+'px';cursor.style.top=my+'px'});
(function anim(){rx+=(mx-rx)*.12;ry+=(my-ry)*.12;ring.style.left=rx+'px';ring.style.top=ry+'px';requestAnimationFrame(anim)})();
document.querySelectorAll('a,button,.card,.profile,.element-card,.section-dot,.concl-cta,.timeline-photo,.pd-img').forEach(function(el){
  el.addEventListener('mouseenter',function(){cursor.style.width='20px';cursor.style.height='20px';ring.style.width='60px';ring.style.height='60px'});
  el.addEventListener('mouseleave',function(){cursor.style.width='12px';cursor.style.height='12px';ring.style.width='36px';ring.style.height='36px'});
});
var bar=document.getElementById('progressBar');
window.addEventListener('scroll',function(){
  var pct=window.scrollY/(document.body.scrollHeight-window.innerHeight)*100;
  bar.style.width=pct+'%';
});
var sectionIds=['hero','contesto','architetti','elementi','prima-dopo','controversie','citazione','conclusione'];
var dots=document.querySelectorAll('.section-dot');
dots.forEach(function(dot,i){dot.addEventListener('click',function(){_scrollTo(sectionIds[i])})});
var secEls=sectionIds.map(function(id){return document.getElementById(id)}).filter(Boolean);
var secObs=new IntersectionObserver(function(entries){
  entries.forEach(function(e){
    if(e.isIntersecting){
      var idx=sectionIds.indexOf(e.target.id);
      dots.forEach(function(d){d.classList.remove('active')});
      if(idx>=0)dots[idx].classList.add('active');
    }
  });
},{threshold:0.45});
secEls.forEach(function(el){secObs.observe(el)});
var revealObs=new IntersectionObserver(function(entries){
  entries.forEach(function(e){if(e.isIntersecting)e.target.classList.add('visible')});
},{threshold:0.12,rootMargin:'0px 0px -40px 0px'});
document.querySelectorAll('.reveal,.reveal-left,.reveal-right,.quote-text,.quote-author').forEach(function(el){revealObs.observe(el)});
var tlItems=document.querySelectorAll('.timeline-item');
var tlObs=new IntersectionObserver(function(entries){
  entries.forEach(function(e){
    if(e.isIntersecting){
      var idx=Array.from(tlItems).indexOf(e.target);
      setTimeout(function(){e.target.classList.add('visible')},idx*130);
      tlObs.unobserve(e.target);
    }
  });
},{threshold:0.15});
tlItems.forEach(function(el){tlObs.observe(el)});
var elemCards=document.querySelectorAll('.element-card');
var elemObs=new IntersectionObserver(function(entries){
  entries.forEach(function(e){
    if(e.isIntersecting){
      var idx=Array.from(elemCards).indexOf(e.target);
      setTimeout(function(){e.target.classList.add('visible')},idx*90);
      elemObs.unobserve(e.target);
    }
  });
},{threshold:0.1});
elemCards.forEach(function(el){elemObs.observe(el)});
var contrItems=document.querySelectorAll('.contr-item');
var contrObs=new IntersectionObserver(function(entries){
  entries.forEach(function(e){
    if(e.isIntersecting){
      var idx=Array.from(contrItems).indexOf(e.target);
      setTimeout(function(){e.target.classList.add('visible')},idx*90);
      contrObs.unobserve(e.target);
    }
  });
},{threshold:0.1});
contrItems.forEach(function(el){contrObs.observe(el)});
function animCounter(el,target){
  var start=null;
  (function step(ts){
    if(!start)start=ts;
    var p=Math.min((ts-start)/2000,1);
    var e=1-Math.pow(1-p,3);
    el.textContent=Math.floor(e*target);
    if(p<1)requestAnimationFrame(step);
    else el.textContent=target;
  })(performance.now());
}
var counterObs=new IntersectionObserver(function(entries){
  entries.forEach(function(e){
    if(e.isIntersecting&&e.target.dataset.count){
      animCounter(e.target,parseInt(e.target.dataset.count));
      counterObs.unobserve(e.target);
    }
  });
},{threshold:0.5});
document.querySelectorAll('[data-count]').forEach(function(el){counterObs.observe(el)});
var lastScroll=0;
window.addEventListener('scroll',function(){
  var now=window.scrollY;
  if(Math.abs(now-lastScroll)>80){spawnParticle();lastScroll=now}
});
function spawnParticle(){
  var p=document.createElement('div');
  p.className='particle';
  p.style.left=(20+Math.random()*(window.innerWidth-40))+'px';
  p.style.top=(window.innerHeight*.5+Math.random()*window.innerHeight*.4)+'px';
  p.style.animationDelay=(Math.random()*.4)+'s';
  p.style.animationDuration=(2.5+Math.random()*2)+'s';
  document.body.appendChild(p);
  setTimeout(function(){p.remove()},5000);
}
</script>

